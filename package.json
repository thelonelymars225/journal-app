{
  "name": "journal-app",
  "private": true,
  "version": "0.1.0",
  "description": "A private journal that sorts entries into life topics with a small on-device model.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/fetch-model.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "dist:mac": "node scripts/fetch-model.mjs --require && vite build && electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "vite": "6.4.1"
  },
  "productName": "Journal",
  "author": "mshari",
  "build": {
    "appId": "app.journal.local",
    "productName": "Journal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Journal-${version}-${arch}.${ext}"
    }
  }
}
